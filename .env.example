# PostgreSQL
DATABASE_URL="postgresql://nio_market:CHANGE_ME@localhost:5432/nio_market?schema=public"

# Required: 32+ random characters
AUTH_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"

# Encrypt merchant delivery API credentials at rest (32+ random chars; keep secret)
APP_ENCRYPTION_KEY="CHANGE_ME_WITH_A_LONG_RANDOM_ENCRYPTION_KEY"

# One-time first owner bootstrap secret (24+ chars)
BOOTSTRAP_SECRET="CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET"

NEXT_PUBLIC_APP_URL="https://app.example.com"
META_GRAPH_API_VERSION="vXX.X"

# Optional seed owner. Prefer /setup for first production deployment.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="NIO Market Owner"

# One-time store purchase workflow
# Local/private storage for payment proofs; mount this directory as a persistent volume in production.
PAYMENT_PROOF_DIR="./private/payment-proofs"
# Recommended for automatic delivery of approved merchant credentials.
RESEND_API_KEY=""
EMAIL_FROM="NIO Market <noreply@example.com>"
# Display only if you later want to show a configured purchase price. Leave blank until the price is decided.
STORE_PURCHASE_PRICE_DZD=""
# Optional public price displayed on /buy. Must match the agreed one-time store price.
NEXT_PUBLIC_STORE_PURCHASE_PRICE_DZD=""
